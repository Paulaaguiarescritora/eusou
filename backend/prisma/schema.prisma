generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User and Auth models (Fase 1)
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  roles         UserRole[]
  refreshTokens RefreshToken[]
  affiliate     Affiliate?
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  users       UserRole[]
}

model UserRole {
  user   User   @relation(fields: [userId], references: [id])
  userId String
  role   Role   @relation(fields: [roleId], references: [id])
  roleId Int

  @@id([userId, roleId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  timestamp DateTime @default(now())
  userId    String?
  metadata  Json?
}

// Product Core (Fase 2A)
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductCostSource {
  COST_FROM_F7
  MANUAL
}

model Product {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  sku              String?           @unique
  shortDescription String?
  description      String?
  status           ProductStatus     @default(DRAFT)
  brand            String?
  basePrice        Decimal?          @db.Decimal(10, 2)
  costSource       ProductCostSource @default(COST_FROM_F7)
  manualCost       Decimal?          @db.Decimal(10, 2)
  wholesalePrice   Decimal?          @db.Decimal(10, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // F2B relations
  attributeValues ProductAttributeValue[]
  variants        ProductVariant[]
  media           Media[]

  // F3 relations
  niches          ProductNiche[]
  categories      ProductCategory[]
  tags            ProductTag[]

  // F4 relations
  catalogItems    CatalogItem[]
  collectionItems CollectionItem[]

  // F5 relations
  orderItems      OrderItem[]

  // F6 relations
  affiliateLinks  AffiliateLink[]
  commissionRules CommissionRule[]

  // F7 relations
  productionProfiles ProductionProfile[]
  productionJobs     ProductionJob[]
  inventories        Inventory[]
  stockMovements     StockMovement[]

  // F9 relations
  channelProducts    ChannelProduct[]
  productChannels    ProductChannel[]

  // F12 relations
  productChannelPrices ProductChannelPrice[]
}

// F2B: Attribute Definitions (global, reusable across products)
model AttributeDefinition {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productAttributeValues   ProductAttributeValue[]
  channelAttributeMappings ChannelAttributeMapping[]
}

// F2B: Product Attribute Values
model ProductAttributeValue {
  id                    String   @id @default(uuid())
  productId             String
  attributeDefinitionId String
  value                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product                Product             @relation(fields: [productId], references: [id])
  attributeDefinition    AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])
  variantAttributeValues VariantAttributeValue[]

  @@unique([productId, attributeDefinitionId, value])
  @@index([productId])
}

// F2B: Product Variants
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String?
  sku       String?  @unique
  price     Decimal? @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product                Product               @relation(fields: [productId], references: [id])
  variantAttributeValues VariantAttributeValue[]
  media                  Media[]
  orderItems             OrderItem[]

  // F7 relations
  productionProfiles     ProductionProfile[]
  productionJobs         ProductionJob[]
  inventories            Inventory[]
  stockMovements         StockMovement[]

  // F12 relations
  productChannelPrices   ProductChannelPrice[]

  @@index([productId])
}

// F2B: Variant Attribute Values (junction between variant and product attribute values)
model VariantAttributeValue {
  id                      String @id @default(uuid())
  variantId               String
  productAttributeValueId String

  variant               ProductVariant        @relation(fields: [variantId], references: [id])
  productAttributeValue ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id])

  @@unique([variantId, productAttributeValueId])
  @@index([variantId])
}

// F2B: Media
enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id        String    @id @default(uuid())
  productId String
  variantId String?
  type      MediaType
  url       String
  altText   String?
  title     String?
  sortOrder Int       @default(0)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
}


// ==========================================
// F3: NICHES, CATEGORIES, TAGS & THEMES
// ==========================================

enum NicheStatus {
  ACTIVE
  INACTIVE
}

model Niche {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  status      NicheStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categories      Category[]
  products        ProductNiche[]
  catalogs        Catalog[]
  commissionRules CommissionRule[]

  // Consolidação Arquitetural: Identidade pública contextualizada pelo Nicho
  brandName       String?
  logoUrl         String?
  faviconUrl      String?
  defaultThemeId  String?
  defaultTheme    Theme?   @relation("NicheDefaultTheme", fields: [defaultThemeId], references: [id], onDelete: SetNull)

  // Rastreabilidade de Pedidos e Preços contextuais
  orders          Order[]
  channelPrices   ProductChannelPrice[]

  @@index([defaultThemeId])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  status      CategoryStatus @default(ACTIVE)
  parentId    String?
  nicheId     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryHierarchy")
  niche    Niche?            @relation(fields: [nicheId], references: [id])
  products          ProductCategory[]
  commissionRules   CommissionRule[]
  channelCategories ChannelCategory[]

  @@index([parentId])
  @@index([nicheId])
}

enum TagStatus {
  ACTIVE
  INACTIVE
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    TagStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products ProductTag[]
}

model ProductNiche {
  productId String
  nicheId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  niche   Niche   @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@id([productId, nicheId])
  @@index([productId])
  @@index([nicheId])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

enum ThemeStatus {
  ACTIVE
  INACTIVE
}

model Theme {
  id              String      @id @default(uuid())
  name            String
  slug            String      @unique
  description     String?
  status          ThemeStatus @default(ACTIVE)
  logo            String?
  primaryColor    String      @default("#000000")
  secondaryColor  String      @default("#ffffff")
  font            String      @default("Inter")
  buttonStyle     String      @default("rounded")
  cardStyle       String      @default("elevated")
  bannerStyle     String      @default("full-width")
  productsPerRow  Int         @default(4)
  showCategories  Boolean     @default(true)
  showHighlights  Boolean     @default(true)
  showNewProducts Boolean     @default(true)
  showOffers      Boolean     @default(true)
  isPreset        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  catalogs        Catalog[]
  defaultNiches   Niche[]     @relation("NicheDefaultTheme")
}


// ==========================================
// F4: CATALOGS & COLLECTIONS
// ==========================================

enum CatalogStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CatalogType {
  MANUAL
  AUTOMATIC
}

enum CatalogRuleType {
  NICHE
  CATEGORY
  TAG
}

model Catalog {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  status      CatalogStatus @default(DRAFT)
  type        CatalogType   @default(MANUAL)
  nicheId     String?
  themeId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  niche       Niche?        @relation(fields: [nicheId], references: [id])
  theme       Theme?        @relation(fields: [themeId], references: [id])

  items          CatalogItem[]
  collections    CatalogCollection[]
  rules          CatalogRule[]
  affiliateLinks AffiliateLink[]

  @@index([nicheId])
  @@index([themeId])
}

model CatalogItem {
  id        String   @id @default(uuid())
  catalogId String
  productId String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  catalog   Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([catalogId, productId])
  @@index([catalogId])
  @@index([productId])
}

model CatalogRule {
  id        String          @id @default(uuid())
  catalogId String
  type      CatalogRuleType
  value     String
  createdAt DateTime        @default(now())

  catalog   Catalog         @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@index([catalogId])
}

enum CollectionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Collection {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  description      String?
  coverMediaId     String?
  status           CollectionStatus @default(DRAFT)
  ownerAffiliateId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  ownerAffiliate   Affiliate?       @relation("AffiliateOwnedCollections", fields: [ownerAffiliateId], references: [id])
  items            CollectionItem[]
  catalogs         CatalogCollection[]
  affiliateLinks   AffiliateLink[]

  @@index([ownerAffiliateId])
}

model CollectionItem {
  id           String     @id @default(uuid())
  collectionId String
  productId    String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model CatalogCollection {
  id           String     @id @default(uuid())
  catalogId    String
  collectionId String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  catalog      Catalog    @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([catalogId, collectionId])
  @@index([catalogId])
  @@index([collectionId])
}


// ==========================================
// F5: ORDERS & ORDER ITEMS
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(uuid())
  customerName    String
  customerEmail   String
  customerPhone   String
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  shippingAmount  Decimal     @default(0.00) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)

  // Address
  street          String
  number          String
  complement      String?
  neighborhood    String
  city            String
  state           String
  zipCode         String

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  affiliateCode   String?
  items           OrderItem[]
  conversion      AffiliateConversion?
  channelOrder    ChannelOrder?
  payments        Payment[]

  // Consolidação Arquitetural: Origem Comercial do Pedido e Prazo de Pagamento (24h)
  paymentDeadline DateTime?
  nicheId         String?
  channelId       String?
  originDomain    String?
  utmSource       String?

  niche           Niche?      @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  channel         Channel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([customerEmail])
  @@index([status])
  @@index([affiliateCode])
  @@index([nicheId])
  @@index([channelId])
  @@index([paymentDeadline])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  EXPIRED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String
  provider             String        // 'MOCK_DEMO_PROVIDER', 'MERCADO_PAGO'
  providerPaymentId    String?       // ID externo do pagamento no Mercado Pago
  providerOrderId      String?       // ID externo da order se aplicável
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("BRL")
  paidAt               DateTime?
  expiresAt            DateTime?
  failureCode          String?
  failureMessage       String?
  externalStatus       String?
  externalStatusDetail String?
  idempotencyKey       String?       @unique
  pixQrCode            String?       // Payload copia e cola Pix
  pixQrCodeBase64      String?       // Imagem QR code base64 se fornecida
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                  String          @id @default(uuid())
  orderId             String
  productId           String
  variantId           String?
  productNameSnapshot String
  skuSnapshot         String?
  quantity            Int
  unitPrice           Decimal         @db.Decimal(10, 2)
  subtotal            Decimal         @db.Decimal(10, 2)
  createdAt           DateTime        @default(now())

  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id])
  variant             ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}


// ==========================================
// F6: AFFILIATES, LINKS, CLICKS, CONVERSIONS & COMMISSIONS
// ==========================================

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Affiliate {
  id          String          @id @default(uuid())
  userId      String          @unique
  code        String          @unique
  displayName String
  cpf         String?
  whatsapp    String?
  pixKey      String?
  themeConfig Json?
  status      AffiliateStatus @default(ACTIVE)
  defaultCommissionPercent Decimal? @default(10.00) @db.Decimal(5, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id])

  links            AffiliateLink[]
  clicks           AffiliateClick[]
  conversions      AffiliateConversion[]
  commissionRules  CommissionRule[]
  ownedCollections Collection[]          @relation("AffiliateOwnedCollections")

  @@index([code])
  @@index([status])
}

model AffiliateLink {
  id           String    @id @default(uuid())
  affiliateId  String
  code         String    @unique
  destination  String
  productId    String?
  catalogId    String?
  collectionId String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  affiliate    Affiliate   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  catalog      Catalog?    @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  clicks       AffiliateClick[]
  conversions  AffiliateConversion[]

  @@index([affiliateId])
  @@index([code])
}

model AffiliateClick {
  id              String   @id @default(uuid())
  affiliateId     String
  affiliateLinkId String?
  productId       String?
  sessionId       String?
  createdAt       DateTime @default(now())

  affiliate       Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateLink   AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@index([affiliateLinkId])
  @@index([createdAt])
}

enum ConversionStatus {
  PENDING
  APPROVED
  CANCELLED
}

model AffiliateConversion {
  id               String           @id @default(uuid())
  affiliateId      String
  affiliateLinkId  String?
  orderId          String           @unique
  amount           Decimal          @db.Decimal(10, 2)
  commissionAmount Decimal          @db.Decimal(10, 2)
  appliedCommissionPercent Decimal? @db.Decimal(5, 2)
  status           ConversionStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  affiliate        Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateLink    AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([orderId])
  @@index([createdAt])
  @@index([status])
}

model CommissionRule {
  id          String   @id @default(uuid())
  affiliateId String?
  productId   String?
  categoryId  String?
  nicheId     String?
  percentage  Decimal  @db.Decimal(5, 2)
  fixedAmount Decimal? @db.Decimal(10, 2)
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  product     Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  niche       Niche?     @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([productId])
  @@index([categoryId])
  @@index([nicheId])
  @@index([priority])
}

// ==========================================
// F7: PRODUÇÃO, IMPRESSORAS, MATERIAIS, CUSTOS E ESTOQUE
// ==========================================

enum PrinterStatus {
  AVAILABLE
  PRINTING
  MAINTENANCE
  INACTIVE
}

model Printer {
  id                 String        @id @default(uuid())
  name               String
  model              String
  status             PrinterStatus @default(AVAILABLE)
  location           String?
  machineCostPerHour Decimal       @default(0.00) @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  productionJobs     ProductionJob[]
  productionProfiles ProductionProfile[]

  @@index([status])
}

enum MaterialType {
  PLA
  PETG
  ABS
  RESIN
  OTHER
}

enum MaterialCategory {
  PRODUCTION
  COMPONENT
  PACKAGING
}

enum MaterialUnit {
  GRAM
  KILOGRAM
  METER
  PIECE
  UNIT
}

model Material {
  id              String           @id @default(uuid())
  name            String
  type            MaterialType     @default(PLA)
  category        MaterialCategory @default(PRODUCTION)
  color           String?
  unit            MaterialUnit     @default(GRAM)
  costPerUnit     Decimal          @db.Decimal(10, 4)
  currentQuantity Decimal          @default(0) @db.Decimal(12, 3)
  minimumQuantity Decimal          @default(0) @db.Decimal(12, 3)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  productionMaterials ProductionMaterial[]
  materialMovements   MaterialMovement[]

  @@index([type])
  @@index([category])
  @@index([isActive])
}

enum ProductionMode {
  STOCK
  MAKE_TO_ORDER
}

model ProductionProfile {
  id                     String         @id @default(uuid())
  productId              String?
  variantId              String?
  printerId              String?
  productionMode         ProductionMode @default(STOCK)
  productionTimeMinutes  Int            @default(0)
  productionTimeSeconds  Int?           @default(0)
  materialWeightGrams    Decimal        @default(0) @db.Decimal(10, 2)
  powerConsumptionWatts  Int            @default(0)
  finishingTimeMinutes   Int            @default(0)
  finishingCost          Decimal        @default(0.00) @db.Decimal(10, 2)
  packagingCost          Decimal        @default(0.00) @db.Decimal(10, 2)
  laborCost              Decimal        @default(0.00) @db.Decimal(10, 2)
  notes                  String?
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  product                Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant                ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  printer                Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  materials              ProductionMaterial[]

  @@index([productId])
  @@index([variantId])
  @@index([printerId])
  @@index([isActive])
}

model ProductionMaterial {
  id                  String            @id @default(uuid())
  productionProfileId String
  materialId          String
  quantity            Decimal           @db.Decimal(10, 3)
  unit                MaterialUnit      @default(GRAM)
  percentage          Decimal?          @db.Decimal(5, 2)
  notes               String?

  productionProfile   ProductionProfile @relation(fields: [productionProfileId], references: [id], onDelete: Cascade)
  material            Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([productionProfileId])
  @@index([materialId])
}

model EnergyCostConfig {
  id         String   @id @default(uuid())
  costPerKwh Decimal  @db.Decimal(10, 4)
  currency   String   @default("BRL")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

enum ProductionJobStatus {
  QUEUED
  PRINTING
  PAUSED
  COMPLETED
  CANCELLED
}

model ProductionJob {
  id               String              @id @default(uuid())
  productId        String
  variantId        String?
  printerId        String
  status           ProductionJobStatus @default(QUEUED)
  plannedQuantity  Int                 @default(1)
  producedQuantity Int                 @default(0)
  rejectedQuantity Int                 @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  estimatedCost    Decimal             @default(0.00) @db.Decimal(10, 2)
  actualCost       Decimal?            @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  printer          Printer             @relation(fields: [printerId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([printerId])
  @@index([productId])
  @@index([createdAt])
}

model Inventory {
  id               String          @id @default(uuid())
  productId        String?
  variantId        String?
  quantity         Int             @default(0)
  reservedQuantity Int             @default(0)
  minimumQuantity  Int             @default(1)
  updatedAt        DateTime        @updatedAt

  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId])
  @@index([productId])
  @@index([variantId])
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
}

model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  variantId     String?
  type          StockMovementType
  quantity      Int
  referenceType String?           // 'ORDER', 'PRODUCTION', 'MANUAL_ADJUSTMENT'
  referenceId   String?
  reason        String
  createdBy     String?
  createdAt     DateTime          @default(now())

  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
  @@index([referenceId])
}

enum MaterialMovementType {
  IN
  OUT
  ADJUSTMENT
}

model MaterialMovement {
  id            String               @id @default(uuid())
  materialId    String
  type          MaterialMovementType
  quantity      Decimal              @db.Decimal(12, 3)
  referenceType String?              // 'PRODUCTION_JOB', 'MANUAL_ADJUSTMENT', 'PURCHASE'
  referenceId   String?
  reason        String
  createdBy     String?
  createdAt     DateTime             @default(now())

  material      Material             @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([createdAt])
  @@index([referenceId])
}

// ==========================================
// F9: ARQUITETURA DE MARKETPLACES, CANAIS E CONECTORES
// ==========================================

enum ChannelType {
  OWN_STORE
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  TIKTOK_SHOP
  GOOGLE_MERCHANT
  OTHER
}

model Channel {
  id          String        @id @default(uuid())
  name        String
  type        ChannelType
  isActive    Boolean       @default(true)
  description String?
  icon        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  accounts                 ChannelAccount[]
  categories               ChannelCategory[]
  pricingChannelRules      PricingChannelRule[]
  productChannelPrices     ProductChannelPrice[]
  marketplaceEvents        MarketplaceEvent[]
  channelOrders            ChannelOrder[]
  orders                   Order[]
  productChannels          ProductChannel[]
  attributeMappings        ChannelAttributeMapping[]

  @@index([type])
  @@index([isActive])
}

// ==========================================
// CANAIS COMERCIAIS: DISPONIBILIDADE DIRETA N:N
// ==========================================

model ProductChannel {
  id        String   @id @default(uuid())
  productId String
  channelId String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([productId, channelId])
  @@index([productId])
  @@index([channelId])
  @@index([isEnabled])
}

enum ChannelAccountStatus {
  ACTIVE
  INACTIVE
  ERROR
  DISCONNECTED
  PENDING
}

model ChannelAccount {
  id                String               @id @default(uuid())
  channelId         String
  name              String
  status            ChannelAccountStatus @default(PENDING)
  externalAccountId String?
  configuration     Json?
  lastSyncAt        DateTime?
  errorMessage      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  channel           Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelProducts   ChannelProduct[]
  syncLogs          ChannelSyncLog[]
  channelOrders     ChannelOrder[]

  @@index([channelId])
  @@index([status])
}

enum ChannelProductStatus {
  DRAFT
  PENDING
  PUBLISHED
  PAUSED
  ERROR
  UNPUBLISHED
}

model ChannelProduct {
  id                String               @id @default(uuid())
  productId         String
  channelAccountId  String
  externalProductId String?
  externalUrl       String?
  externalSku       String?
  priceOverride     Decimal?             @db.Decimal(10, 2)
  status            ChannelProductStatus @default(DRAFT)
  lastSyncAt        DateTime?
  lastError         String?
  syncPayload       Json?
  
  // F13B: Operational metadata & User Products support
  externalUserProductId String?
  externalFamilyId      String?
  externalVariationId   String?
  lastObservedPrice     Decimal?             @db.Decimal(10, 2)
  lastObservedStock     Int?
  lastObservedStatus    String?
  lastObservedAt        DateTime?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  channelAccount    ChannelAccount       @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  syncLogs          ChannelSyncLog[]

  @@unique([productId, channelAccountId])
  @@index([productId])
  @@index([channelAccountId])
  @@index([status])
  @@index([externalProductId])
}

model ChannelCategory {
  id                   String   @id @default(uuid())
  channelId            String
  categoryId           String
  externalCategoryId   String
  externalCategoryName String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  channel              Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  category             Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([channelId, categoryId])
  @@index([channelId])
  @@index([categoryId])
}

enum ChannelSyncOperation {
  PUBLISH
  UPDATE
  PRICE
  STOCK
  UNPUBLISH
  SYNC
  TEST_CONNECTION
}

enum ChannelSyncStatus {
  SUCCESS
  ERROR
  PENDING
}

model ChannelSyncLog {
  id               String               @id @default(uuid())
  channelAccountId String
  channelProductId String?
  operation        ChannelSyncOperation
  status           ChannelSyncStatus
  message          String?
  details          Json?
  externalCode     String?
  durationMs       Int?
  createdAt        DateTime             @default(now())

  channelAccount   ChannelAccount       @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  channelProduct   ChannelProduct?      @relation(fields: [channelProductId], references: [id], onDelete: SetNull)

  @@index([channelAccountId])
  @@index([channelProductId])
  @@index([operation])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// F12: MOTOR DE PRECIFICAÇÃO POR CANAL
// ==========================================

enum RoundingRule {
  NONE
  DECIMAL_TWO
  ENDS_90
  ENDS_99
}

enum PriceCalculationMode {
  AUTOMATIC
  MANUAL
}

model PricingProfile {
  id                    String              @id @default(uuid())
  name                  String
  slug                  String              @unique
  description           String?
  isDefault             Boolean             @default(false)
  isActive              Boolean             @default(true)
  defaultTargetMargin   Decimal             @default(0.20) @db.Decimal(5, 4) // ex: 0.20 = 20%
  taxRate               Decimal             @default(0.04) @db.Decimal(5, 4) // ex: 0.04 = 4%
  packagingCost         Decimal             @default(1.00) @db.Decimal(10, 2)
  roundingRule          RoundingRule        @default(ENDS_90)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  channelRules          PricingChannelRule[]
  productChannelPrices  ProductChannelPrice[]

  @@index([isActive])
  @@index([isDefault])
}

model PricingChannelRule {
  id                    String              @id @default(uuid())
  pricingProfileId      String
  channelId             String
  channelType           ChannelType
  isActive              Boolean             @default(true)
  name                  String?
  targetMargin          Decimal?            @db.Decimal(5, 4) // override per channel or null to inherit
  commissionPercent     Decimal             @default(0) @db.Decimal(5, 4)
  fixedCost             Decimal             @default(0) @db.Decimal(10, 2)
  fixedCostPercent      Decimal             @default(0) @db.Decimal(5, 4)
  otherPercent          Decimal             @default(0) @db.Decimal(5, 4)
  otherFixedCost        Decimal             @default(0) @db.Decimal(10, 2)
  orderFixedCost        Decimal             @default(0) @db.Decimal(10, 2)
  paymentFeePercent     Decimal             @default(0) @db.Decimal(5, 4)
  notes                 String?
  version               Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  pricingProfile        PricingProfile      @relation(fields: [pricingProfileId], references: [id], onDelete: Cascade)
  channel               Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tiers                 PricingRuleTier[]

  @@unique([pricingProfileId, channelId])
  @@index([channelId])
  @@index([pricingProfileId])
  @@index([channelType])
}

model PricingRuleTier {
  id                    String              @id @default(uuid())
  pricingChannelRuleId  String
  name                  String?
  minPrice              Decimal             @default(0) @db.Decimal(10, 2)
  maxPrice              Decimal             @default(999999.00) @db.Decimal(10, 2)
  commissionPercent     Decimal             @default(0) @db.Decimal(5, 4)
  fixedCost             Decimal             @default(0) @db.Decimal(10, 2)
  fixedCostPercent      Decimal             @default(0) @db.Decimal(5, 4)
  otherPercent          Decimal             @default(0) @db.Decimal(5, 4)
  otherFixedCost        Decimal             @default(0) @db.Decimal(10, 2)
  priority              Int                 @default(0)
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  pricingChannelRule    PricingChannelRule  @relation(fields: [pricingChannelRuleId], references: [id], onDelete: Cascade)

  @@index([pricingChannelRuleId])
  @@index([minPrice, maxPrice])
}

model ProductChannelPrice {
  id                    String                @id @default(uuid())
  productId             String
  variantId             String?
  channelId             String
  nicheId               String?
  pricingProfileId      String?
  mode                  PriceCalculationMode  @default(AUTOMATIC)
  costBasis             Decimal               @db.Decimal(10, 2)
  calculatedPrice       Decimal               @db.Decimal(10, 2)
  manualPrice           Decimal?              @db.Decimal(10, 2)
  effectivePrice        Decimal               @db.Decimal(10, 2)
  netProfit             Decimal               @db.Decimal(10, 2)
  netMargin             Decimal               @db.Decimal(5, 4)
  appliedRuleTierId     String?
  calculationDetails    Json?
  lastCalculatedAt      DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  product               Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant               ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  channel               Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pricingProfile        PricingProfile?       @relation(fields: [pricingProfileId], references: [id], onDelete: SetNull)
  niche                 Niche?                @relation(fields: [nicheId], references: [id], onDelete: SetNull)

  @@unique([productId, channelId, variantId, nicheId])
  @@index([productId])
  @@index([variantId])
  @@index([channelId])
  @@index([nicheId])
  @@index([pricingProfileId])
  @@index([mode])
}

// ==========================================
// F13A: MARKETPLACE HUB CORE
// ==========================================

enum MarketplaceEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model MarketplaceEvent {
  id              String                 @id @default(uuid())
  channelId       String
  externalEventId String
  topic           String
  resource        String?
  payload         Json
  status          MarketplaceEventStatus @default(RECEIVED)
  attempts        Int                    @default(0)
  lastError       String?
  processedAt     DateTime?
  nextAttemptAt   DateTime?
  receivedAt      DateTime               @default(now())

  channel         Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalEventId])
  @@index([channelId])
  @@index([status])
  @@index([topic])
  @@index([nextAttemptAt])
  @@index([receivedAt])
}

model ChannelOrder {
  id                   String         @id @default(uuid())
  channelId            String
  channelAccountId     String
  orderId              String         @unique
  externalOrderId      String
  externalBuyerId      String?
  externalStatus       String
  externalTotal        Decimal        @db.Decimal(10, 2)
  externalCurrency     String         @default("BRL")
  commissionFee        Decimal?       @db.Decimal(10, 2)
  shippingFee          Decimal?       @db.Decimal(10, 2)
  rawPayload           Json?
  syncedAt             DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  channel              Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelAccount       ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalOrderId])
  @@index([channelId])
  @@index([channelAccountId])
  @@index([externalOrderId])
  @@index([externalStatus])
  @@index([syncedAt])
}

model ChannelAttributeMapping {
  id                   String               @id @default(uuid())
  channelId            String
  externalCategoryId   String?
  attributeDefinitionId String
  externalAttributeId  String
  externalAttributeName String?
  isRequired           Boolean              @default(false)
  defaultValue         String?
  valueMapping         Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  channel              Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attributeDefinition  AttributeDefinition  @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalCategoryId, attributeDefinitionId])
  @@index([channelId])
  @@index([externalCategoryId])
  @@index([attributeDefinitionId])
  @@index([externalAttributeId])
}
