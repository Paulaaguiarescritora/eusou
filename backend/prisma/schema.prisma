generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and Auth models (Fase 1)
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  roles         UserRole[]
  refreshTokens RefreshToken[]
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  users       UserRole[]
}

model UserRole {
  user   User   @relation(fields: [userId], references: [id])
  userId String
  role   Role   @relation(fields: [roleId], references: [id])
  roleId Int

  @@id([userId, roleId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  timestamp DateTime @default(now())
  userId    String?
  metadata  Json?
}

// Product Core (Fase 2A)
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  sku              String?       @unique
  shortDescription String?
  description      String?
  status           ProductStatus @default(DRAFT)
  brand            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // F2B relations
  attributeValues ProductAttributeValue[]
  variants        ProductVariant[]
  media           Media[]
}

// F2B: Attribute Definitions (global, reusable across products)
model AttributeDefinition {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productAttributeValues ProductAttributeValue[]
}

// F2B: Product Attribute Values
model ProductAttributeValue {
  id                    String   @id @default(uuid())
  productId             String
  attributeDefinitionId String
  value                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product                Product             @relation(fields: [productId], references: [id])
  attributeDefinition    AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])
  variantAttributeValues VariantAttributeValue[]

  @@unique([productId, attributeDefinitionId, value])
  @@index([productId])
}

// F2B: Product Variants
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String?
  sku       String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product                Product               @relation(fields: [productId], references: [id])
  variantAttributeValues VariantAttributeValue[]
  media                  Media[]

  @@index([productId])
}

// F2B: Variant Attribute Values (junction between variant and product attribute values)
model VariantAttributeValue {
  id                      String @id @default(uuid())
  variantId               String
  productAttributeValueId String

  variant               ProductVariant        @relation(fields: [variantId], references: [id])
  productAttributeValue ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id])

  @@unique([variantId, productAttributeValueId])
  @@index([variantId])
}

// F2B: Media
enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id        String    @id @default(uuid())
  productId String
  variantId String?
  type      MediaType
  url       String
  altText   String?
  title     String?
  sortOrder Int       @default(0)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
}
