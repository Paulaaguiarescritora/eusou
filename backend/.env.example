# Application Port
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase)
# Format for Direct connection: postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public
# Format for Supabase Pooler (Transaction / Port 6543): postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?schema=public"

# Authentication & JWT Secrets
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_REFRESH_SECRET"

# Mercado Livre Marketplace Integration (F10)
MERCADOLIVRE_CLIENT_ID="SEU_MERCADOLIVRE_APP_ID"
MERCADOLIVRE_CLIENT_SECRET="SEU_MERCADOLIVRE_SECRET_KEY"
MERCADOLIVRE_REDIRECT_URI="http://localhost:3000/admin/marketplaces/mercadolivre/callback"
MERCADOLIVRE_ENCRYPTION_KEY="32_CHAR_HEX_OR_KEY_FOR_AES_256_GCM"
