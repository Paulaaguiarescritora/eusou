# Application Port
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase)
# DATABASE_URL for application / runtime connection (Supabase Transaction Pooler - Port 6543):
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL for Prisma Migrate / Session mode (Supabase Session Pooler - Port 5432):
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Authentication & JWT Secrets
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_REFRESH_SECRET"

# Mercado Livre Marketplace Integration (F10)
MERCADOLIVRE_CLIENT_ID="SEU_MERCADOLIVRE_APP_ID"
MERCADOLIVRE_CLIENT_SECRET="SEU_MERCADOLIVRE_SECRET_KEY"
MERCADOLIVRE_REDIRECT_URI="http://localhost:3000/admin/marketplaces/mercadolivre/callback"
MERCADOLIVRE_ENCRYPTION_KEY="32_CHAR_HEX_OR_KEY_FOR_AES_256_GCM"

# Mercado Pago Payment Gateway Integration (F16-A)
# TEST or PRODUCTION (defaults to TEST if omitted)
MERCADOPAGO_ENVIRONMENT="TEST"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-SEU_MERCADOPAGO_ACCESS_TOKEN"
MERCADOPAGO_PUBLIC_KEY="APP_USR-SEU_MERCADOPAGO_PUBLIC_KEY"
MERCADOPAGO_WEBHOOK_SECRET="SEU_MERCADOPAGO_WEBHOOK_SECRET_KEY"
MERCADOPAGO_WEBHOOK_URL="https://seu-dominio.com.br/payments/webhooks/mercadopago"

# Backup & Disaster Recovery Off-Site Storage (F17-A.1)
# Storage Type: 'vault' (HTTP vault) or 's3' (AWS S3, Cloudflare R2, MinIO)
BACKUP_STORAGE_TYPE="vault"
BACKUP_OFFSITE_ENDPOINT="http://127.0.0.1:9099"
BACKUP_OFFSITE_BUCKET="eusou-backups-offsite"
BACKUP_OFFSITE_TOKEN="CHANGE_ME_TO_A_SECURE_OFFSITE_TOKEN"

# Optional S3 Configuration (when BACKUP_STORAGE_TYPE="s3")
S3_BUCKET="seu-bucket-offsite-backup"
S3_REGION="sa-east-1"
S3_ENDPOINT="https://s3.sa-east-1.amazonaws.com"
S3_ACCESS_KEY_ID="SEU_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="SEU_SECRET_ACCESS_KEY"


