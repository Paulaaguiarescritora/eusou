{
  "name": "product-platform-backend",
  "version": "0.1.0",
  "description": "Backend monolith for product platform",
  "main": "dist/main.js",
  "scripts": {
    "start": "nest start",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:backup": "node ../scripts/backup/backup.js",
    "db:backup:offsite": "node ../scripts/backup/run-backup-pipeline.js",
    "db:restore": "node ../scripts/backup/restore.js",
    "db:restore:offsite": "node ../scripts/backup/offsite-restore.js",
    "db:integrity": "node ../scripts/backup/compare-integrity.js",
    "db:verify-restore": "node ../scripts/backup/test-prisma-restored.js",
    "db:test-failures": "node ../scripts/backup/test-failures.js",
    "start:prod": "node dist/main.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@prisma/client": "^5.0.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "inherits": "^2.0.4",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.5",
    "xlsx": "^0.18.5",
    "@nestjs/cli": "^10.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.3.3",
    "@types/node": "^20.11.24",
    "@types/express": "^4.17.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "passport-jwt": "^4.0.1",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2"
  }
}
